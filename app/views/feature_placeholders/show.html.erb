<% content_for :title, "#{@feature.fetch(:title)} | OshiLog" %>

<section class="card placeholder">
  <h1><%= @feature.fetch(:title) %></h1>
  <p><%= @feature.fetch(:message) %></p>
  <% if @feature[:subscription_link] %>
    <%= link_to "固定費を管理する", subscriptions_path, class: "button" %>
  <% end %>
  <% if @feature[:record_link] %>
    <%= link_to "記録する", new_activity_path, class: "button" %>
  <% end %>
</section>
