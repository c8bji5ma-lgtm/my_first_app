<nav aria-label="グローバルナビゲーション">
  <ul class="nav-items">
    <% if user_signed_in? %>
      <li><%= link_to "トップ", root_path, aria: { current: ("page" if current_page?(root_path) || current_page?(home_path)) } %></li>
      <li><%= link_to "推し一覧", oshis_path, aria: { current: ("page" if current_page?(oshis_path)) } %></li>
      <li><%= link_to "活動記録一覧", activities_path, aria: { current: ("page" if current_page?(activities_path)) } %></li>
      <li><%= link_to "マイページ", my_page_path, aria: { current: ("page" if current_page?(my_page_path)) } %></li>
      <li><%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav-logout" %></li>
    <% else %>
      <li><%= link_to "ログイン", new_user_session_path, aria: { current: ("page" if current_page?(new_user_session_path)) } %></li>
      <li><%= link_to "新規登録", new_user_registration_path, aria: { current: ("page" if current_page?(new_user_registration_path)) } %></li>
    <% end %>
  </ul>
</nav>
